# --- Model providers ---
# Groq (primary) — fast, free tier available
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_QUALITY=llama-3.3-70b-versatile

# NVIDIA NIM (fallback)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_QUALITY=meta/llama-3.1-70b-instruct

# Ollama fallback — no key needed, assumes `ollama serve` running locally
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_FAST=llama3.1:8b
OLLAMA_MODEL_QUALITY=llama3.1:70b

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App secret from the Meta App Dashboard (App Settings > Basic) -- NOT the
# same value as the access token or verify token above. Used to verify
# the X-Hub-Signature-256 header on every inbound webhook POST. Without
# this set, the server refuses ALL webhook traffic (fails closed).
WHATSAPP_APP_SECRET=

# --- Server ---
PORT=3000

# --- Operator Dashboard ---
# Generate with: npx tsx bin/hash-password.ts "your-password-here"
# Never store the plaintext password anywhere, including here.
OPERATOR_PASSWORD_HASH=
